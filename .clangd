# build/ is GCC; clangd needs Clang flags and a libc++ `std` module:
#   cmake -G Ninja -B build-clangd -DCMAKE_CXX_COMPILER=clang++ -DCMAKE_CXX_FLAGS=-stdlib=libc++ -DVIMF_BUILD_TESTS=ON
# Run clangd with --experimental-modules-support --compile-commands-dir=build-clangd;
# this fragment alone can't reach libc++'s std.cppm. See dev/decisions.md.
CompileFlags:
  CompilationDatabase: build-clangd
