// Canonical C ABI for LuaJIT FFI.
// Included by Api.h for C++ compile-time checks and read directly by
// lua/vimficiency/ffi/core.lua for ffi.cdef().
//
// Data crosses as protobuf (src/LuaExports/proto/). A `request` is one
// serialized message, borrowed for the call. A VFByteSlice return is a
// serialized vf.Envelope around the result message named beside the export.
// Job and view ids alone cross as plain ints.

typedef struct {
  const char* data;
  size_t len;
} VFByteSlice;

const char* vf_version_string();
const char* vf_abi_hash();
// The compiled schema, raw (no envelope), for pb.load().
VFByteSlice vf_proto_descriptor();

// vf.config (lua_exports.cpp)
VFByteSlice vf_enums();                                             // Enums
VFByteSlice vf_apply_config(const char* request, size_t request_len);  // Config -> vf.Empty
void vf_reset_config();
VFByteSlice vf_debug_config();                                      // vf.Text
VFByteSlice vf_get_warnings();                                      // vf.Text

// vf.search (AnalyzeExports.cpp)
VFByteSlice vf_build_search_request(const char* request, size_t request_len); // BuildSearchRequest -> SearchRequest
VFByteSlice vf_analyze(const char* request, size_t request_len);              // AnalyzeRequest -> AnalyzeResult
VFByteSlice vf_analyze_start_async(const char* request, size_t request_len);  // AnalyzeRequest -> vf.JobHandle
VFByteSlice vf_analyze_poll(int job_id);                                      // AnalyzeResult
int vf_analyze_cancel(int job_id);
VFByteSlice vf_get_optimizer_defaults();                                      // OptimizerDefaults

// vf.session (UtilityExports.cpp)
VFByteSlice vf_tokenize_movements(const char* request, size_t request_len);     // SequenceRequest -> Tokens
VFByteSlice vf_tokenize_sequence(const char* request, size_t request_len);      // SequenceRequest -> Tokens
VFByteSlice vf_build_sequence(const char* request, size_t request_len);         // BuildSequenceRequest -> vf.Text
VFByteSlice vf_typed_keys(const char* request, size_t request_len);             // TypedKeysRequest -> vf.Text
VFByteSlice vf_manual_evict_reason(const char* request, size_t request_len);    // ManualEvictRequest -> ManualEvict

// vf.stats (StatsExports.cpp)
VFByteSlice vf_append_session(const char* request, size_t request_len);  // AppendSessionRequest -> vf.Empty
VFByteSlice vf_stats_summary(const char* request, size_t request_len);   // SummaryRequest -> Summary
VFByteSlice vf_stats_runs(const char* request, size_t request_len);      // RunsRequest -> RunList
VFByteSlice vf_stats_run(const char* request, size_t request_len);       // RunRequest -> RunDetail

// vf.display (DisplayExports.cpp)
VFByteSlice vf_sequence_display_lines(const char* request, size_t request_len);         // SequenceRequest -> vf.Lines
VFByteSlice vf_sequence_display_inline(const char* request, size_t request_len);        // SequenceRequest -> vf.Text
VFByteSlice vf_sequence_display_key_notation(const char* request, size_t request_len);  // vf.Text -> vf.Text
VFByteSlice vf_sequence_display_typed_text(const char* request, size_t request_len);    // TypedTextRequest -> vf.Text
VFByteSlice vf_sequence_display_typed_chunks(const char* request, size_t request_len);  // TypedChunksRequest -> vf.Text
VFByteSlice vf_format_result_position(const char* request, size_t request_len);         // SessionResult -> vf.Text
VFByteSlice vf_format_result_kind_suffix(const char* request, size_t request_len);      // SessionResult -> vf.Text
VFByteSlice vf_format_result_message(const char* request, size_t request_len);          // ResultMessageRequest -> vf.Text

// vf.explore (InteractiveExports.cpp)
VFByteSlice vf_explore_start_async(const char* request, size_t request_len);       // StartRequest -> vf.JobHandle
VFByteSlice vf_explore_poll(int job_id);                                           // ViewHandle
int vf_explore_cancel(int job_id);
int vf_explore_destroy(int view_id);
VFByteSlice vf_explore_state(int view_id);                                         // State
VFByteSlice vf_explore_recommendations(const char* request, size_t request_len);   // RecommendationsRequest -> Recommendations
VFByteSlice vf_explore_reconfigure_plan(const char* request, size_t request_len);  // ReconfigurePlanRequest -> ReconfigurePlanResult
VFByteSlice vf_explore_current_lines(int view_id);                                 // vf.Lines
VFByteSlice vf_explore_accept_snapshot(const char* request, size_t request_len);   // SnapshotRequest -> ApplyResult
VFByteSlice vf_explore_undo(int view_id);                                          // ApplyResult
VFByteSlice vf_explore_redo(int view_id);                                          // ApplyResult
VFByteSlice vf_explore_header_rows(int view_id);                                   // HeaderRows
